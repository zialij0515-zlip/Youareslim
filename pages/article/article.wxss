.page { min-height: 100vh; box-sizing: border-box; padding: 36rpx 32rpx 60rpx; background: #F8F6F1; }
.hero { padding: 8rpx 4rpx 28rpx; }
.a-title { display: block; font-size: 44rpx; font-weight: 700; color: #25342B; line-height: 1.3; }
.a-sum { display: block; margin-top: 16rpx; font-size: 26rpx; color: #5E9B75; line-height: 1.6; }
.body { padding: 36rpx 32rpx; background: #FFFEFA; border-radius: 28rpx; box-shadow: 0 10rpx 26rpx rgba(86, 111, 91, .07); }
.para { display: block; font-size: 28rpx; color: #445049; line-height: 1.9; margin-bottom: 24rpx; }
.para:last-child { margin-bottom: 0; }
.note { margin-top: 28rpx; font-size: 22rpx; color: #B7C0B5; line-height: 1.7; padding: 0 8rpx; }
.empty { text-align: center; color: #B7C0B5; font-size: 28rpx; margin-top: 120rpx; }
