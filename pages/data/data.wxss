.stats{display:flex;gap:18rpx;margin:30rpx 0}.stat{flex:1;padding:26rpx;display:flex;flex-direction:column;gap:9rpx;color:#738179;font-size:24rpx}.stat b{font-size:48rpx;color:#355A43}.stat small{font-size:23rpx}.insight{padding:28rpx;display:grid;grid-template-columns:1fr auto;gap:13rpx;font-size:29rpx}.insight .score{color:#4C8463;font-size:46rpx;font-weight:700}.insight .muted{grid-column:span 2;line-height:1.6}.chart-card{padding:20rpx}.chart{height:300rpx;position:relative;background:repeating-linear-gradient(to bottom,transparent 0,transparent 72rpx,#EDF1EC 73rpx)}.point{position:absolute;width:18rpx;height:18rpx;margin-left:-9rpx;margin-bottom:-9rpx;border-radius:50%;background:#5E9B75;box-shadow:0 0 0 8rpx #E1EFE3}.point text{position:absolute;bottom:27rpx;left:-24rpx;width:65rpx;text-align:center;font-size:20rpx;color:#4C7057}.trend{padding:8rpx 28rpx}.row{display:flex;justify-content:space-between;padding:25rpx 0;border-bottom:1rpx solid #EEF0EB;font-size:26rpx}.row:last-child{border:0}.empty{padding:50rpx;text-align:center;color:#929B94}.disclosure{margin-top:25rpx;padding:25rpx;display:flex;flex-direction:column;gap:10rpx;font-size:25rpx}.disclosure text:last-child{color:#748179;line-height:1.6}
