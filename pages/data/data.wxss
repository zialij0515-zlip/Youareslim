.stats { display: flex; gap: 18rpx; margin: 30rpx 0; }
.stat { flex: 1; padding: 26rpx; display: flex; flex-direction: column; gap: 9rpx; color: #738179; font-size: 24rpx; }
.stat-label { font-size: 24rpx; color: #738179; }
.stat-main { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.stat-value { font-size: 48rpx; color: #355A43; font-weight: 600; }
.stat-unit { font-size: 23rpx; }
.stat-badge { padding: 6rpx 14rpx; border-radius: 16rpx; background: #E8F0E6; color: #4F8567; font-size: 24rpx; font-weight: 500; }
.stat-hint { font-size: 20rpx; color: #929B94; }

/* BMI 标准范围条 */
.bmi-scale { padding: 28rpx; display: flex; flex-direction: column; gap: 18rpx; }
.bmi-scale-title { display: flex; align-items: center; gap: 10rpx; }
.bmi-scale-label { font-size: 29rpx; color: #3E3E3E; font-weight: 600; }
.bmi-help { width: 34rpx; height: 34rpx; border-radius: 50%; border: 2rpx solid #E2DAF0; background: #F0ECF8; display: flex; align-items: center; justify-content: center; font-size: 23rpx; color: #8E7AB8; }
.bmi-scale-bar-wrap { position: relative; padding-top: 28rpx; }
.bmi-scale-bar { display: flex; border-radius: 16rpx; overflow: hidden; }
.bmi-section { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 16rpx 0 14rpx; gap: 4rpx; }
.bmi-section:nth-child(1) { background: #E9F0F4; color: #5A7A8A; }
.bmi-section:nth-child(2) { background: #E9F3E8; color: #4F8567; }
.bmi-section:nth-child(3) { background: #FCF4E7; color: #C88A3E; }
.bmi-section:nth-child(4) { background: #FBECEE; color: #B85C5C; }
.bmi-section.active { font-weight: 600; }
.bmi-section-name { font-size: 24rpx; }
.bmi-section-range { font-size: 20rpx; opacity: 0.9; }
.bmi-pointer { position: absolute; top: 0; transform: translateX(-50%); }
.bmi-pointer-icon { position: relative; width: 0; height: 0; border-left: 12rpx solid transparent; border-right: 12rpx solid transparent; border-top: 18rpx solid #6B9A6F; }
.bmi-pointer-icon::after { content: ''; position: absolute; top: -30rpx; left: 50%; transform: translateX(-50%); width: 16rpx; height: 16rpx; border-radius: 50%; background: #6B9A6F; border: 3rpx solid #fff; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.12); }
.bmi-advice { margin-top: 4rpx; font-size: 25rpx; color: #6B6B6B; line-height: 1.6; }

.toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin: 28rpx 0 18rpx; }
.section-title { margin: 50rpx 0 24rpx; }
.segment { display: flex; background: #EEF2ED; border-radius: 999rpx; padding: 6rpx; gap: 4rpx; }
.segment.right { background: transparent; padding: 0; }
.seg { padding: 12rpx 26rpx; font-size: 25rpx; color: #738179; border-radius: 999rpx; transition: all .2s; }
.seg.small { padding: 10rpx 20rpx; font-size: 22rpx; background: #EEF2ED; }
.seg.selected { background: #4F8567; color: #FFFFFF; font-weight: 600; }
.segment.right .seg.selected { background: #FFFFFF; color: #4F8567; border: 1rpx solid #4F8567; }

.chart-card { position: relative; z-index: 0; overflow: hidden; padding: 16rpx; min-height: 360rpx; display: flex; align-items: stretch; }
.chart { position: absolute; top: 0; left: 0; width: 100%; height: 420rpx; transform: translateZ(0); }

.trend { padding: 8rpx 28rpx; }
.row { display: flex; justify-content: space-between; padding: 25rpx 0; border-bottom: 1rpx solid #EEF0EB; font-size: 26rpx; }
.row:last-child { border: 0; }
.row.header { padding: 18rpx 0; font-size: 24rpx; color: #9BA7A0; border-bottom: 1rpx solid #E4E8E2; }
.row-date { flex: 1; color: #738179; }
.row-weight { flex: 1; text-align: center; color: #355A43; font-weight: 600; }
.row-bmi { flex: 1; text-align: right; color: #929B94; }
.row.header .row-weight { color: #9BA7A0; font-weight: 400; }
.row.header .row-bmi { color: #9BA7A0; }

.empty { padding: 60rpx 20rpx; text-align: center; color: #929B94; font-size: 25rpx; }
