.stats { display: flex; gap: 18rpx; margin: 30rpx 0; }
.stat { flex: 1; padding: 26rpx; display: flex; flex-direction: column; gap: 9rpx; color: #738179; font-size: 24rpx; }
.stat-label { font-size: 24rpx; color: #738179; }
.stat-main { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.stat-value { font-size: 48rpx; color: #355A43; font-weight: 600; }
.stat-unit { font-size: 23rpx; }
.stat-badge { padding: 6rpx 14rpx; border-radius: 16rpx; background: #E8F0E6; color: #4F8567; font-size: 24rpx; font-weight: 500; }
.stat-hint { font-size: 20rpx; color: #929B94; }

.insight { padding: 28rpx; display: grid; grid-template-columns: 1fr auto; gap: 13rpx; font-size: 29rpx; }
.insight-label { font-size: 26rpx; color: #738179; }
.insight .score { color: #4C8463; font-size: 46rpx; font-weight: 700; }
.insight .muted { grid-column: span 2; line-height: 1.6; color: #929B94; font-size: 24rpx; }

.toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin: 8rpx 0 18rpx; }
.segment { display: flex; background: #EEF2ED; border-radius: 999rpx; padding: 6rpx; gap: 4rpx; }
.segment.right { background: transparent; padding: 0; }
.seg { padding: 12rpx 26rpx; font-size: 25rpx; color: #738179; border-radius: 999rpx; transition: all .2s; }
.seg.small { padding: 10rpx 20rpx; font-size: 22rpx; background: #EEF2ED; }
.seg.selected { background: #4F8567; color: #FFFFFF; font-weight: 600; }
.segment.right .seg.selected { background: #FFFFFF; color: #4F8567; border: 1rpx solid #4F8567; }

.chart-card { padding: 16rpx; min-height: 360rpx; display: flex; align-items: stretch; }
.chart { width: 100%; height: 420rpx; }

.trend { padding: 8rpx 28rpx; }
.row { display: flex; justify-content: space-between; padding: 25rpx 0; border-bottom: 1rpx solid #EEF0EB; font-size: 26rpx; }
.row:last-child { border: 0; }
.row-date { color: #738179; }
.row-weight { color: #355A43; font-weight: 600; }
.row-bmi { color: #929B94; }

.empty { padding: 60rpx 20rpx; text-align: center; color: #929B94; font-size: 25rpx; }

.disclosure { margin-top: 25rpx; padding: 25rpx; display: flex; flex-direction: column; gap: 10rpx; font-size: 25rpx; }
.disclosure-title { color: #738179; font-weight: 600; }
.disclosure-body { color: #748179; line-height: 1.6; }
