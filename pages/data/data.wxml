<view class="page">
  <text class="eyebrow">只和过去的自己比较</text>
  <view class="page-title">你的数据轨迹</view>

  <view class="stats">
    <view class="card stat">
      <text class="stat-label">当前 BMI</text>
      <text class="stat-value">{{latest.bmi || '—'}}</text>
      <text class="stat-hint">{{latest.bmi ? '估算值' : '待记录'}}</text>
    </view>
    <view class="card stat">
      <text class="stat-label">估算体脂</text>
      <text class="stat-value">{{latest.bodyFat || '—'}}<text class="stat-unit" wx:if="{{latest.bodyFat}}">%</text></text>
      <text class="stat-hint">仅供趋势参考</text>
    </view>
  </view>

  <view class="card insight">
    <text class="insight-label">本周打卡完成度</text>
    <text class="score">{{completion}}%</text>
    <text class="muted">{{note}}</text>
  </view>

  <text class="section-title">体重趋势</text>
  <view class="card chart-card">
    <view wx:if="{{points.length}}" class="chart">
      <view wx:for="{{points}}" wx:key="date" class="point" style="left:{{item.left}}%;bottom:{{item.bottom}}%;">
        <text class="point-weight">{{item.weight}}</text>
      </view>
    </view>
    <view wx:else class="empty">记录体重后，这里会生成你的趋势图</view>
  </view>

  <text class="section-title">最近 7 次身体记录</text>
  <view class="card trend">
    <view wx:if="{{records.length}}" wx:for="{{records}}" wx:key="date" class="row">
      <text class="row-date">{{item.date}}</text>
      <text class="row-weight">{{item.weight}} kg</text>
      <text class="row-bmi">BMI {{item.bmi}}</text>
    </view>
    <view wx:else class="empty">暂无身体数据</view>
  </view>

  <view class="card disclosure">
    <text class="disclosure-title">关于估算体脂率</text>
    <text class="disclosure-body">它根据年龄、性别与 BMI 推算，适合观察变化趋势，不代表专业测量结果。</text>
  </view>
</view>
