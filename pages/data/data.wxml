<view class="page">
  <text class="eyebrow">只和过去的自己比较</text>
  <view class="page-title">你的数据轨迹</view>

  <view class="stats">
    <view class="card stat">
      <text class="stat-label">BMI 指数</text>
      <view class="stat-main">
        <text class="stat-value">{{latest.bmi || '—'}}</text>
        <text class="stat-badge" wx:if="{{bmiLabel}}">{{bmiLabel}}</text>
      </view>
      <text class="stat-hint">{{latest.bmi ? '估算值' : '待记录'}}</text>
    </view>
    <view class="card stat">
      <text class="stat-label">体脂率</text>
      <view class="stat-main">
        <text class="stat-value">{{latest.bodyFat || '—'}}<text class="stat-unit" wx:if="{{latest.bodyFat}}">%</text></text>
        <text class="stat-badge" wx:if="{{bodyFatLabel}}">{{bodyFatLabel}}</text>
      </view>
      <text class="stat-hint">仅供趋势参考</text>
    </view>
  </view>

  <view class="card bmi-scale">
    <view class="bmi-scale-title">
      <text class="bmi-scale-label">BMI标准范围</text>
      <view class="bmi-help" bindtap="goBmiGuide">?</view>
    </view>
    <view class="bmi-scale-bar-wrap">
      <view class="bmi-pointer" style="left: {{bmiPointerLeft}}%;" wx:if="{{latest.bmi}}">
        <view class="bmi-pointer-icon"></view>
      </view>
      <view class="bmi-scale-bar">
        <view wx:for="{{bmiSections}}" wx:key="key" class="bmi-section {{item.active?'active':''}}">
          <text class="bmi-section-name">{{item.name}}</text>
          <text class="bmi-section-range">{{item.range}}</text>
        </view>
      </view>
    </view>
    <text class="bmi-advice">{{bmiAdvice}}</text>
  </view>

  <view class="toolbar">
    <view class="segment">
      <view wx:for="{{metricOptions}}" wx:key="key" class="seg {{metricKey===item.key?'selected':''}}" data-key="{{item.key}}" bindtap="changeMetric">{{item.name}}</view>
    </view>
    <view class="segment right">
      <view wx:for="{{rangeOptions}}" wx:key="key" class="seg small {{rangeKey===item.key?'selected':''}}" data-key="{{item.key}}" bindtap="changeRange">{{item.name}}</view>
    </view>
  </view>

  <view class="card chart-card">
    <canvas type="2d" id="chart" class="chart"></canvas>
    <view wx:if="{{!hasData}}" class="empty">这个时间段还没有数据，先去记录吧～</view>
  </view>

  <text class="section-title">最近记录（7次）</text>
  <view class="card trend">
    <block wx:if="{{records.length}}">
      <view class="row header">
        <text class="row-date">日期</text>
        <text class="row-weight">体重</text>
        <text class="row-bmi">BMI指数</text>
      </view>
      <view wx:for="{{records}}" wx:key="date" class="row">
        <text class="row-date">{{item.date}}</text>
        <text class="row-weight">{{item.weight}} kg</text>
        <text class="row-bmi">{{item.bmi}}</text>
      </view>
    </block>
    <block wx:else>
      <view class="empty">暂无身体数据</view>
    </block>
  </view>
</view>
