.user{padding:30rpx;display:flex;gap:22rpx;align-items:center}.avatar{width:86rpx;height:86rpx;border-radius:50%;background:#CFE5D2;color:#48765A;display:flex;align-items:center;justify-content:center;font-size:38rpx;font-weight:700}.user .muted{display:block;margin-top:8rpx}.progress{padding:30rpx;margin-top:22rpx;display:flex;flex-direction:column;gap:10rpx}.big{font-size:58rpx;font-weight:700;color:#497A5A}.big small{font-size:24rpx}.list{padding:8rpx 28rpx;margin-bottom:24rpx}.list view{display:flex;justify-content:space-between;padding:25rpx 0;border-bottom:1rpx solid #EEF0EB}.list view:last-child{border:0}.list text:last-child{color:#67806E}.poster{margin-top:28rpx;padding:28rpx;display:flex;flex-direction:column;gap:20rpx}.poster .primary-button{margin:0}
