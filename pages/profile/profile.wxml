<view class="page">
  <view class="card user">
    <view class="avatar">轻</view>
    <view class="user-meta">
      <text class="page-title">{{profile.nickname}}</text>
      <text class="muted">按自己的节奏，慢慢来</text>
    </view>
  </view>

  <view class="card progress">
    <text class="progress-label">距目标体重</text>
    <text class="big">{{(current.weight || profile.startWeight) - profile.targetWeight}} <text class="unit">kg</text></text>
    <text class="muted">目标 {{profile.targetWeight}} kg · 起始 {{profile.startWeight}} kg</text>
  </view>

  <text class="section-title">个人档案</text>
  <view class="card list">
    <view class="list-row">
      <text class="row-label">身高</text>
      <text class="row-value">{{profile.height}} cm</text>
    </view>
    <view class="list-row">
      <text class="row-label">年龄</text>
      <text class="row-value">{{profile.age}} 岁</text>
    </view>
    <view class="list-row">
      <text class="row-label">估算体脂率</text>
      <text class="row-value">{{current.bodyFat || '待记录'}}{{current.bodyFat ? '%' : ''}}</text>
    </view>
  </view>

  <button class="ghost-button" bindtap="edit">编辑档案与目标</button>

  <text class="section-title">提醒设置</text>
  <view class="card remind-card">
    <view class="remind-row">
      <view class="remind-text">
        <text class="remind-name">每日打卡提醒</text>
        <text class="remind-desc">当天未打卡时提醒你去记录</text>
      </view>
      <switch checked="{{profile.remindCheckIn}}" bindchange="toggleRemind" color="#4F8567"/>
    </view>
  </view>

  <view class="card poster">
    <text class="poster-text">达成目标后，生成你的轻减海报</text>
    <button class="primary-button" bindtap="poster">查看目标海报</button>
  </view>
</view>
