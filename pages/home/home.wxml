<view class="page">
  <!-- 问候区：按时间变化 + 动漫小插画 -->
  <view class="greeting">
    <view class="greeting-text">
      <text class="hello">{{greeting}}，{{nickname}}</text>
      <text class="muted">不求完美，记录就是在靠近自己。</text>
    </view>
    <image class="mascot" src="/assets/mascot.png" mode="aspectFit"/>
  </view>

  <!-- 今日体重卡：参考图样式 -->
  <view class="card hero">
    <view class="hero-top">
      <view class="hero-main">
        <text class="hero-label">今日体重</text>
        <view class="hero-weight"><text class="hero-value">{{current}}</text><text class="hero-unit">kg</text></view>
        <text class="change {{changeClass}}">{{changeArrow}} {{changeText}} kg</text>
      </view>
      <view class="streak-card">
        <text class="streak-label">连续打卡</text>
        <view class="streak-num"><text>{{continuousDays}}</text><text class="streak-unit">天</text></view>
      </view>
    </view>
    <view class="bar">
      <view class="bar-fill" style="width:{{progress}}%"></view>
      <view class="bar-dot start"></view>
      <view class="bar-dot current" style="left:{{progress}}%"></view>
      <view class="bar-dot target"></view>
    </view>
    <view class="bar-labels">
      <text>初始 {{startWeight}}kg</text>
      <text>目标 {{target}}kg</text>
    </view>
  </view>

  <!-- 今日打卡 -->
  <view class="section-title-sm checkin-title">今日打卡</view>
  <view class="task-grid">
    <view class="card task {{item.done ? 'done' : ''}}" wx:for="{{grid}}" wx:key="type" data-type="{{item.type}}" bindtap="record">
      <view class="task-icon-box" style="background:{{item.color}}15">
      <image class="task-icon" src="/assets/icons/{{item.icon}}.svg" mode="aspectFit"/>
    </view>
      <view class="task-info">
        <text class="task-label">{{item.label}}打卡</text>
        <text class="task-sub {{item.done ? 'done' : ''}}">{{item.sub}}</text>
      </view>
      <view class="task-right">
        <view wx:if="{{item.showCheck}}" class="check-circle">✓</view>
        <text wx:else class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card task treat" data-type="treat" bindtap="record">
    <view class="task-icon-box" style="background:#E8927C15">
      <image class="task-icon" src="/assets/icons/cake.svg" mode="aspectFit"/>
    </view>
    <view class="task-info">
      <text class="task-label">放纵餐打卡</text>
      <text class="task-sub">本周已放纵 {{treatWeekCount}} 次</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 减脂Tips -->
  <view class="tips-head">
    <text class="section-title-sm tips-title">减脂Tips</text>
  </view>
  <view class="tips">
    <view class="card tip-entry" data-tab="methods" bindtap="openTip">
      <image class="tip-icon" src="/assets/icons/tip-methods.svg" mode="aspectFit"/>
      <view class="tip-text"><text class="tip-name">更多减脂方法</text><text class="tip-desc">血型减肥法、韩女减肥法…</text></view>
      <text class="tip-arrow">›</text>
    </view>
    <view class="card tip-entry" data-tab="sports" bindtap="openTip">
      <image class="tip-icon" src="/assets/icons/tip-sports.svg" mode="aspectFit"/>
      <view class="tip-text"><text class="tip-name">更好的运动</text><text class="tip-desc">推荐运动，点击了解</text></view>
      <text class="tip-arrow">›</text>
    </view>
    <view class="card tip-entry" data-tab="diary" bindtap="openTip">
      <image class="tip-icon" src="/assets/icons/tip-share.svg" mode="aspectFit"/>
      <view class="tip-text"><text class="tip-name">我的减脂日记</text><text class="tip-desc">{{diaryLatest ? diaryLatest : '记录今天的小确幸'}}</text></view>
      <text class="tip-arrow">›</text>
    </view>
  </view>

  <!-- 弹层：我的减脂日记 -->
  <view class="mask" wx:if="{{diaryOpen}}" bindtap="closeDiary">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">我的减脂日记</text>
        <text class="sheet-close" bindtap="closeDiary">✕</text>
      </view>

      <block wx:if="{{diaryView}}">
        <view class="diary-view-date">{{diaryView.date}}</view>
        <scroll-view scroll-y class="diary-view-body">
          <text class="diary-view-text" user-select="true">{{diaryView.text}}</text>
        </scroll-view>
        <button class="ghost-button" bindtap="closeDiaryView">返回列表</button>
      </block>

      <block wx:else>
        <view class="diary-editor">
          <text class="diary-editor-date">{{today}}</text>
          <textarea class="diary-input" value="{{diaryDraft}}" bindinput="onDiaryInput" placeholder="写下今天的减脂心情、饮食或运动小记…" maxlength="500"/>
        </view>
        <button class="primary-button" bindtap="saveDiary">保存今天的日记</button>

        <view class="diary-history-head" wx:if="{{diaryList.length}}">历史日记（{{diaryList.length}}）</view>
        <scroll-view scroll-y class="diary-list" wx:if="{{diaryList.length}}">
          <view class="diary-item" wx:for="{{diaryList}}" wx:key="id" data-id="{{item.id}}" bindtap="viewDiary">
            <text class="diary-item-date">{{item.date}}</text>
            <text class="diary-item-preview">{{item.preview}}</text>
            <text class="diary-item-arrow">›</text>
          </view>
        </scroll-view>
        <view class="diary-empty" wx:else>还没有历史日记，写下第一篇吧～</view>
      </block>
    </view>
  </view>
</view>
