/* 问候区 */
.greeting { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 0 26rpx; }
.greeting-text { display: flex; flex-direction: column; gap: 12rpx; }
.hello { font-size: 40rpx; font-weight: 700; color: #25342B; }
.mascot { width: 132rpx; height: 132rpx; flex: none; border-radius: 24rpx; }

/* 今日体重 hero */
.hero { padding: 34rpx 32rpx 28rpx; display: flex; flex-direction: column; gap: 28rpx; background: #F0F6EF; }
.hero-top { display: flex; align-items: flex-start; justify-content: space-between; }
.hero-main { display: flex; flex-direction: column; gap: 10rpx; }
.hero-label { color: #789080; font-size: 24rpx; }
.hero-weight { display: flex; align-items: baseline; gap: 8rpx; }
.hero-value { font-size: 76rpx; font-weight: 700; color: #25342B; line-height: 1; }
.hero-unit { font-size: 28rpx; color: #849088; }
.change { font-size: 26rpx; color: #849088; }
.change.down { color: #4F8567; }
.change.up { color: #D98B6F; }
.change.flat { color: #849088; }
.change.empty { color: #B7C0B5; }
/* 连续打卡小卡 */
.streak-card { background: #F3F7F1; border-radius: 20rpx; padding: 16rpx 22rpx; display: flex; flex-direction: column; align-items: center; gap: 6rpx; flex: none; }
.streak-label { color: #5E9B75; font-size: 22rpx; }
.streak-num { display: flex; align-items: baseline; gap: 4rpx; }
.streak-num text { font-size: 44rpx; font-weight: 700; color: #4F8567; line-height: 1; }
.streak-unit { font-size: 22rpx; color: #789080; }

/* 进度条：初始(绿) → 当前(绿) → 目标(粉) */
.bar { position: relative; height: 14rpx; border-radius: 999rpx; background: #E9EBE8; margin: 4rpx 0 6rpx; }
.bar-fill { height: 100%; border-radius: 999rpx; background: #4F8567; }
.bar-dot { position: absolute; top: 50%; width: 20rpx; height: 20rpx; border-radius: 50%; border: 4rpx solid #fff; box-sizing: border-box; transform: translate(-50%, -50%); }
.bar-dot.start { left: 0; background: #4F8567; }
.bar-dot.current { background: #4F8567; }
.bar-dot.target { right: 0; left: auto; transform: translate(50%, -50%); background: #E8927C; }
.bar-labels { display: flex; justify-content: space-between; color: #849088; font-size: 22rpx; }

/* 区块小标题：统一成减脂Tips的深炭黑粗体 */
.section-title-sm { margin: 34rpx 0 24rpx; font-size: 30rpx; font-weight: 700; color: #25342B; letter-spacing: 1rpx; }
.checkin-title { margin: 34rpx 0 24rpx; }
.tips-title { margin: 0; }

/* 今日打卡 */
.task-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.task { padding: 18rpx 20rpx; min-height: 0; display: flex; align-items: center; gap: 18rpx; background: #FFFEFA; border: 1rpx solid #EDF1E9; border-radius: 28rpx; }
.task-icon-box { width: 84rpx; height: 84rpx; border-radius: 22rpx; flex: none; display: flex; align-items: center; justify-content: center; padding: 14rpx; box-sizing: border-box; overflow: hidden; }
.task-icon { width: 100%; height: 100%; }
.task-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.task-label { font-size: 26rpx; color: #25342B; font-weight: 500; letter-spacing: 0.5rpx; }
.task-sub { font-size: 22rpx; color: #9BA7A0; }
.task-sub.done { color: #4F8567; }
.task-right { flex: none; display: flex; align-items: center; }
.check-circle { width: 38rpx; height: 38rpx; border-radius: 50%; background: #4F8567; color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.arrow { color: #B7C0B5; font-size: 36rpx; line-height: 1; }
.task.treat { background: #FBF1EC; border-color: #F5DDD4; margin-top: 18rpx; }

/* 减脂小Tips */
.tips-head { display: flex; align-items: center; margin: 34rpx 0 24rpx; }
.tips-title { font-size: 30rpx; font-weight: 700; color: #25342B; letter-spacing: 1rpx; }
.tips { display: flex; flex-direction: column; gap: 24rpx; margin-bottom: 16rpx; }
.tip-entry { display: flex; align-items: center; gap: 22rpx; padding: 28rpx; background: #F8FBFC; border: 1rpx solid #F1F5F7; box-shadow: none; }
.tip-icon { width: 64rpx; height: 64rpx; flex: none; }
.tip-text { flex: 1; display: flex; flex-direction: column; gap: 10rpx; }
.tip-name { font-size: 29rpx; font-weight: 700; color: #2A4C55; }
.tip-desc { font-size: 23rpx; color: #5E7C85; }
.tip-arrow { color: #8DAEB8; font-size: 36rpx; }

/* 弹层 */
.mask { position: fixed; inset: 0; background: rgba(40, 52, 43, 0.45); display: flex; align-items: flex-end; z-index: 50; }
.sheet { width: 100%; background: #FFFEFA; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 32rpx 48rpx; box-sizing: border-box; max-height: 78vh; display: flex; flex-direction: column; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; color: #25342B; }
.sheet-close { color: #B7C0B5; font-size: 36rpx; padding: 0 8rpx; }
.sheet-list { flex: 1; }
.sheet-item { padding: 22rpx 0; border-bottom: 1rpx solid #EDF0EA; display: flex; flex-direction: column; gap: 10rpx; }
.si-name { font-size: 28rpx; font-weight: 700; color: #4F8567; }
.si-desc { font-size: 24rpx; color: #68756D; line-height: 1.6; }
.share-input { width: 100%; height: 240rpx; background: #F6F8F3; border-radius: 20rpx; padding: 22rpx; box-sizing: border-box; font-size: 26rpx; color: #25342B; margin-bottom: 24rpx; }
.primary-button { background: #4F8567; color: #fff; border-radius: 999rpx; font-size: 30rpx; }
