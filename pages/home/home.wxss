.greeting { display:flex; flex-direction:column; gap:12rpx; margin:12rpx 0 30rpx; }.hero { padding:34rpx; display:flex; justify-content:space-between; align-items:center; }.hero-label { color:#789080; font-size:24rpx; display:block; }.hero-value { display:block; font-size:56rpx; font-weight:700; margin:8rpx 0; }.hero-value text { font-size:25rpx; }.ring { width:128rpx; height:128rpx; border:15rpx solid #DCEBDD; border-top-color:#5E9B75; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#4F8567; font-weight:700; }.task-grid { display:grid; grid-template-columns:repeat(2, 1fr); gap:18rpx; }.task { padding:26rpx; min-height:146rpx; display:flex; flex-direction:column; gap:10rpx; font-size:30rpx; }.task-icon { color:#71A885; font-size:34rpx; }.status { color:#5E9B75; font-size:23rpx; }.status.done { color:#99A39C; }.tip { margin-top:28rpx; padding:28rpx; display:flex; flex-direction:column; gap:10rpx; }
