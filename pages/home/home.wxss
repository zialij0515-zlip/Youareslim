/* 问候区 */
.greeting { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 0 26rpx; }
.greeting-text { display: flex; flex-direction: column; gap: 12rpx; }
.hello { font-size: 40rpx; font-weight: 700; color: #25342B; }
.mascot { width: 120rpx; height: 120rpx; flex: none; }

/* 目标进度 hero */
.hero { padding: 32rpx; display: flex; flex-direction: column; gap: 24rpx; }
.hero-row { display: flex; justify-content: space-between; }
.hero-block { display: flex; flex-direction: column; gap: 8rpx; align-items: center; flex: 1; }
.hero-label { color: #789080; font-size: 22rpx; }
.hero-value { font-size: 40rpx; font-weight: 700; color: #25342B; line-height: 1.1; }
.hero-value .unit { font-size: 22rpx; font-weight: 400; color: #849088; }
.hero-value.down { color: #4F8567; }

/* 进度条：初始 → 当前 → 目标 */
.bar { position: relative; height: 16rpx; border-radius: 999rpx; background: #EAF1EC; margin: 6rpx 0 4rpx; }
.bar-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #7DB98C, #4F8567); }
.bar-dot { position: absolute; top: 50%; width: 24rpx; height: 24rpx; border-radius: 50%; background: #fff; border: 4rpx solid #4F8567; transform: translate(-50%, -50%); }
.bar-labels { display: flex; justify-content: space-between; color: #849088; font-size: 22rpx; }
.bar-pct { color: #4F8567; font-weight: 700; }

/* 今日打卡 */
.section-title { margin: 40rpx 0 18rpx; font-size: 30rpx; font-weight: 700; color: #25342B; }
.task-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.task { padding: 24rpx; min-height: 140rpx; display: flex; flex-direction: column; gap: 12rpx; }
.task-top { display: flex; align-items: center; justify-content: space-between; }
.task-icon { font-size: 44rpx; line-height: 1; }
.task-icon.lg { font-size: 48rpx; flex: none; }
.task-label { font-size: 28rpx; color: #25342B; }
.task-sub { font-size: 24rpx; color: #849088; }
.status { font-size: 22rpx; color: #5E9B75; }
.status.done { color: #99A39C; }
.task.line { flex-direction: row; align-items: center; gap: 22rpx; min-height: auto; }
.task-body { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.task.treat { background: #FBF1EC; }
.status.treat-tag { color: #D98B6F; }

/* 减脂小Tips */
.tips { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 20rpx; }
.tip-entry { display: flex; align-items: center; gap: 22rpx; padding: 26rpx; }
.tip-emoji { font-size: 44rpx; }
.tip-text { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.tip-name { font-size: 29rpx; font-weight: 700; color: #25342B; }
.tip-desc { font-size: 23rpx; color: #849088; }
.tip-arrow { color: #B7C0B5; font-size: 36rpx; }

/* 弹层 */
.mask { position: fixed; inset: 0; background: rgba(40, 52, 43, 0.45); display: flex; align-items: flex-end; z-index: 50; }
.sheet { width: 100%; background: #FFFEFA; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 32rpx 48rpx; box-sizing: border-box; max-height: 78vh; display: flex; flex-direction: column; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; color: #25342B; }
.sheet-close { color: #B7C0B5; font-size: 36rpx; padding: 0 8rpx; }
.sheet-list { flex: 1; }
.sheet-item { padding: 22rpx 0; border-bottom: 1rpx solid #EDF0EA; display: flex; flex-direction: column; gap: 10rpx; }
.si-name { font-size: 28rpx; font-weight: 700; color: #4F8567; }
.si-desc { font-size: 24rpx; color: #68756D; line-height: 1.6; }
.share-input { width: 100%; height: 240rpx; background: #F6F8F3; border-radius: 20rpx; padding: 22rpx; box-sizing: border-box; font-size: 26rpx; color: #25342B; margin-bottom: 24rpx; }
.primary-button { background: #4F8567; color: #fff; border-radius: 999rpx; font-size: 30rpx; }
