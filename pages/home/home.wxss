.greeting { display: flex; flex-direction: column; gap: 12rpx; margin: 12rpx 0 26rpx; }
.hero { padding: 34rpx; display: flex; justify-content: space-between; align-items: center; }
.hero-left { display: flex; flex-direction: column; gap: 8rpx; }
.hero-label { color: #789080; font-size: 24rpx; }
.hero-value { font-size: 56rpx; font-weight: 700; line-height: 1.1; }
.hero-value .unit { font-size: 25rpx; font-weight: 400; color: #849088; }

/* 进度环：conic-gradient 甜甜圈，中心挖空显示百分比 */
.ring { width: 140rpx; height: 140rpx; border-radius: 50%; position: relative; display: flex; align-items: center; justify-content: center; }
.ring-hole { width: 104rpx; height: 104rpx; border-radius: 50%; background: #FFFEFA; display: flex; align-items: center; justify-content: center; }
.ring-text { color: #4F8567; font-weight: 700; font-size: 28rpx; }

/* 可切换 Banner 模块 */
.banner { height: 220rpx; margin-bottom: 8rpx; }
.banner-card { height: 220rpx; border-radius: 32rpx; padding: 36rpx 40rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; gap: 14rpx; }
.banner-label { font-size: 24rpx; color: #4F8567; letter-spacing: 1rpx; }
.banner-main { font-size: 48rpx; font-weight: 700; color: #25342B; line-height: 1.15; }
.banner-sub { font-size: 25rpx; color: #849088; }
.banner-progress { background: #EAF4EC; }
.banner-trend { background: #EAF1F4; }
.banner-cheer { background: #F4F1E9; }
.banner-achievement { background: #F1EAF4; }

/* 今日清单 */
.section-title { margin: 40rpx 0 18rpx; }
.task-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.task { padding: 26rpx; min-height: 150rpx; display: flex; flex-direction: column; gap: 10rpx; }
.task-icon { width: 52rpx; height: 52rpx; border-radius: 50%; background: #EAF4EC; color: #5E9B75; font-size: 30rpx; display: flex; align-items: center; justify-content: center; }
.task-icon.done { background: #5E9B75; color: #fff; }
.task-label { font-size: 30rpx; color: #25342B; }
.status { font-size: 23rpx; color: #5E9B75; }
.status.done { color: #99A39C; }

/* 今日鼓励 */
.tip { margin-top: 28rpx; padding: 28rpx; display: flex; flex-direction: column; gap: 10rpx; }
.tip-title { font-size: 26rpx; font-weight: 700; color: #4F8567; }
