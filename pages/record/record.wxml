<view class="page">
  <view class="page-title record-title">今天发生了什么？</view>

  <view class="type-row">
    <view wx:for="{{typeOptions}}" wx:key="key" class="type {{activeType===item.key?'selected':''}}" data-key="{{item.key}}" bindtap="chooseType">{{item.name}}</view>
  </view>

  <view class="card form">
    <view class="field-block">
      <text class="field-title">添加照片</text>
      <view class="image-row">
        <block wx:if="{{images.length}}">
          <image wx:for="{{images}}" wx:key="*this" class="photo-thumb" src="{{item}}" mode="aspectFill" data-idx="{{index}}" bindtap="previewImage"/>
        </block>
        <block wx:else>
          <image class="photo-thumb sample" src="/assets/record/food1.png" mode="aspectFill"/>
          <image class="photo-thumb sample" src="/assets/record/food2.png" mode="aspectFill"/>
        </block>
        <view class="add-photo" bindtap="chooseImage">
          <text class="add-icon">＋</text>
          <text class="add-text">添加照片</text>
        </view>
      </view>
    </view>

    <view class="field-block">
      <text class="field-title">文字记录</text>
      <textarea placeholder="记录食物和心情" value="{{note}}" data-key="note" bindinput="input" maxlength="120"/>
    </view>

    <view class="field-block">
      <text class="field-title">今日感受</text>
      <view class="mood-row">
        <view wx:for="{{moods}}" wx:key="key" class="mood {{mood===item.key?'selected':''}}" data-key="{{item.key}}" bindtap="chooseMood">
          <image class="mood-icon" src="{{item.icon}}" mode="aspectFit"/>
          <text class="mood-name">{{item.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <button class="primary-button save-button" bindtap="saveCheckin">保存记录</button>

  <view class="section-title weekly-title">本周完成率</view>
  <view class="card weekly-rate">
    <view class="rate-item">
      <view class="ring-wrap">
        <canvas type="2d" id="mealRing" class="ring-canvas"></canvas>
        <text class="ring-percent">{{mealRate}}%</text>
      </view>
      <text class="ring-label">餐食打卡</text>
    </view>
    <view class="rate-item">
      <view class="ring-wrap">
        <canvas type="2d" id="sportRing" class="ring-canvas"></canvas>
        <text class="ring-percent">{{sportRate}}%</text>
      </view>
      <text class="ring-label">运动打卡</text>
    </view>
  </view>

  <view class="section-title data-section-title">数据更新</view>
  <view class="card weight">
    <text class="weight-label">目前体重</text>
    <view class="weight-input-wrap">
      <input type="digit" placeholder="" value="{{weight}}" data-key="weight" bindinput="input"/>
      <text class="weight-unit">kg</text>
    </view>
    <button class="ghost-button update-button" bindtap="saveWeight">更新</button>
  </view>
</view>
