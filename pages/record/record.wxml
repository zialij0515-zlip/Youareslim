<view class="page"><text class="eyebrow">记录不是约束，是看见自己</text><view class="page-title">今天发生了什么？</view><view class="type-row"><view wx:for="{{typeOptions}}" wx:key="key" class="type {{activeType===item.key?'selected':''}}" data-key="{{item.key}}" bindtap="chooseType">{{item.name}}</view></view>
<view class="card form"><text class="field-title">份量</text><view class="chips"><view wx:for="{{portions}}" wx:key="key" class="chip {{portion===item.key?'selected':''}}" data-key="{{item.key}}" bindtap="choosePortion">{{item.name}}</view></view><view class="estimate"><text>{{activeType==='sport'?'预估消耗':'预估热量'}}</text><input type="number" value="{{calories}}" data-key="calories" bindinput="input"/><text>kcal</text></view><textarea placeholder="记录食物、心情、运动内容或今天的感受…" value="{{note}}" data-key="note" bindinput="input" maxlength="240"/><button class="image-button" bindtap="chooseImage">＋ 添加照片（最多 3 张）</button><view class="image-count" wx:if="{{images.length}}">已选择 {{images.length}} 张图片</view></view><button class="primary-button" bindtap="saveCheckin">保存这次记录</button>
<text class="section-title">更新身体数据</text><view class="card weight"><text>今日体重</text><input type="digit" placeholder="例如 60.5" value="{{weight}}" data-key="weight" bindinput="input"/><text>kg</text><button class="ghost-button" bindtap="saveWeight">更新</button></view></view>
