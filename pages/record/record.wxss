/* 标题 */
.record-title { font-size: 40rpx; }

/* tab 行：字体放大，两端对齐 */
.type-row { display: flex; justify-content: space-between; gap: 12rpx; overflow-x: auto; margin: 26rpx 0; }
.type { flex: 1; text-align: center; white-space: nowrap; padding: 18rpx 0; border-radius: 32rpx; background: #EEF1EC; color: #6B786F; font-size: 30rpx; }
.type.selected { background: #D7E9D9; color: #3F7655; font-weight: 600; }

/* 表单 */
.form { padding: 30rpx; display: flex; flex-direction: column; gap: 28rpx; }
.field-block { display: flex; flex-direction: column; gap: 16rpx; }
.field-title { font-size: 29rpx; font-weight: 600; color: #4A5C51; }

/* 添加照片 */
.image-button { background: transparent; color: #54886A; font-size: 27rpx; padding: 0; text-align: left; margin: 0; line-height: 1.5; }
.image-list { display: flex; gap: 16rpx; flex-wrap: wrap; }
.preview-thumb { width: 140rpx; height: 140rpx; border-radius: 20rpx; }
.image-count { color: #839087; font-size: 24rpx; }

/* 文字记录 */
.form textarea { background: #F8F8F4; width: 100%; min-height: 180rpx; box-sizing: border-box; padding: 20rpx; border-radius: 20rpx; font-size: 28rpx; }

/* 预估热量 */
.estimate { display: flex; align-items: center; background: #F2F7F1; border-radius: 20rpx; padding: 22rpx 24rpx; color: #587761; }
.estimate input { flex: 1; text-align: right; font-size: 38rpx; font-weight: 700; color: #3D604A; }
.estimate-unit { font-size: 28rpx; margin-left: 12rpx; }

/* 保存按钮：变小、变浅 */
.save-button { background: #C5DECC; color: #fff; border-radius: 40rpx; font-size: 30rpx; font-weight: 600; line-height: 78rpx; width: auto; margin: 28rpx 0 0; }

/* 本周完成率 */
.weekly-rate { display: flex; justify-content: space-around; align-items: center; background: #F2EFF6; border: 1rpx solid #E8E3EF; padding: 34rpx 24rpx; margin-bottom: 24rpx; }
.rate-item { display: flex; flex-direction: column; align-items: center; gap: 18rpx; }
.ring-wrap { position: relative; width: 180rpx; height: 180rpx; display: flex; align-items: center; justify-content: center; }
.ring-canvas { width: 180rpx; height: 180rpx; }
.ring-percent { position: absolute; font-size: 38rpx; font-weight: 700; color: #25342B; }
.ring-label { font-size: 28rpx; color: #5E5668; }

/* 数据更新 */
.data-section-title { margin-top: 48rpx; }
.weight { padding: 28rpx; display: flex; align-items: center; gap: 20rpx; background: #F7EDEC; border: 1rpx solid #EFE2E0; box-shadow: none; }
.weight-label { font-size: 30rpx; color: #6B4F4D; font-weight: 600; flex: none; }
.weight-input-wrap { flex: 1; display: flex; align-items: center; justify-content: flex-end; gap: 10rpx; }
.weight-input-wrap input { text-align: right; font-size: 36rpx; font-weight: 700; color: #5D4A49; width: 200rpx; }
.weight-unit { font-size: 30rpx; color: #8D7876; }
.update-button { width: 130rpx; margin: 0; font-size: 26rpx; line-height: 64rpx; background: #EAD4D2; color: #7A5A58; }
