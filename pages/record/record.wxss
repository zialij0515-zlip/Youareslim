/* 标题 */
.record-title { font-size: 40rpx; }

/* tab 行：字体放大，两端对齐，未选中鹅黄 */
.type-row { display: flex; justify-content: space-between; gap: 12rpx; overflow-x: auto; margin: 26rpx 0; }
.type { flex: 1; text-align: center; white-space: nowrap; padding: 18rpx 0; border-radius: 32rpx; background: #F2EBD0; color: #7A7562; font-size: 30rpx; }
.type.selected { background: #D7E9D9; color: #3F7655; font-weight: 600; }

/* 表单 */
.form { padding: 30rpx; display: flex; flex-direction: column; gap: 28rpx; }
.field-block { display: flex; flex-direction: column; gap: 16rpx; }
.field-title { font-size: 29rpx; font-weight: 600; color: #4A5C51; }
.field-title-sm { font-size: 24rpx; font-weight: 400; color: #9A9A90; }
.title-line { display: flex; align-items: baseline; gap: 8rpx; }

/* 添加照片 */
.image-row { display: flex; gap: 16rpx; align-items: center; }
.photo-thumb { width: 140rpx; height: 140rpx; border-radius: 24rpx; }
.photo-thumb.sample { opacity: 0.92; }
.add-photo { width: 140rpx; height: 140rpx; border-radius: 24rpx; background: #FDF8F0; border: 2rpx dashed #E5D9C0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; }
.add-icon { color: #C4A57F; font-size: 48rpx; line-height: 1; }
.add-text { color: #C4A57F; font-size: 24rpx; }

/* 文字记录：高度压到原本一半 */
.form textarea { background: #F8F8F4; width: 100%; min-height: 36rpx; box-sizing: border-box; padding: 6rpx 14rpx; border-radius: 14rpx; font-size: 26rpx; line-height: 1.2; }

/* 今日感受 */
.mood-row { display: flex; justify-content: space-around; align-items: center; }
.mood { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 10rpx 14rpx; border-radius: 20rpx; }
.mood.selected { background: #F3F0E6; }
.mood-icon { width: 72rpx; height: 72rpx; }
.mood-name { font-size: 24rpx; color: #6B6B6B; }

/* 运动项目：多选，每行 2 个 */
.sport-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.sport-option { display: flex; align-items: center; gap: 14rpx; width: calc((100% - 12rpx) / 2); box-sizing: border-box; padding: 12rpx 18rpx; border-radius: 18rpx; background: #F8F8F4; border: 2rpx solid #ECECE6; }
.sport-option.selected { background: #EAF3EC; border-color: #BBD9C5; }
.sport-check { width: 34rpx; height: 34rpx; border-radius: 50%; background: #fff; border: 2rpx solid #C9C9C0; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 24rpx; line-height: 1; flex: none; }
.sport-option.selected .sport-check { background: #5E9B75; border-color: #5E9B75; }
.sport-name { font-size: 26rpx; color: #4A5C51; flex: none; }

/* 运动时长 */
.duration-row { display: flex; gap: 12rpx; }
.duration-item { flex: none; display: flex; align-items: center; gap: 8rpx; padding: 10rpx 16rpx; border-radius: 16rpx; background: #F4F1EC; border: 2rpx solid #E6E1D6; }
.duration-name { font-size: 27rpx; color: #4A5C51; flex: none; }
.duration-min { width: 80rpx; min-width: 0; text-align: center; font-size: 26rpx; font-weight: 600; color: #5D4A49; background: transparent; border-radius: 10rpx; padding: 4rpx 0; }
.duration-unit { font-size: 24rpx; color: #9A9A90; flex: none; }

/* 已保存提示 */
.saved-hint { margin: 18rpx 0 0; text-align: center; font-size: 24rpx; color: #5E9B75; font-weight: 600; }

/* 保存按钮 */
.save-button { background: #5E9B75; color: #fff; border-radius: 34rpx; font-size: 28rpx; font-weight: 600; line-height: 64rpx; padding: 0 40rpx; width: auto; margin: 22rpx 0 0; }

/* 本周完成率 */
.weekly-title { margin-top: 38rpx; }
.weekly-rate { display: flex; justify-content: space-around; align-items: center; background: #F2EFF6; border: 1rpx solid #E8E3EF; padding: 18rpx 14rpx; margin-bottom: 20rpx; }
.rate-item { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.ring-wrap { position: relative; width: 116rpx; height: 116rpx; display: flex; align-items: center; justify-content: center; }
.ring-canvas { width: 116rpx; height: 116rpx; }
.ring-percent { position: absolute; font-size: 28rpx; font-weight: 700; color: #25342B; }
.ring-label { font-size: 24rpx; color: #5E5668; }

/* 数据更新：参考图样式，当前体重 + 大数字 + BMI + 累计减重 */
.data-section-title { margin-top: 34rpx; font-size: 38rpx; display: flex; align-items: baseline; gap: 12rpx; }
.section-subtitle { font-size: 24rpx; color: #9A8A88; font-weight: 400; }
.weight { padding: 30rpx 28rpx; display: flex; flex-direction: column; align-items: flex-start; background: #F7EDEC; border: 1rpx solid #EFE2E0; box-shadow: none; }
.weight-label { font-size: 32rpx; color: #6B4F4D; font-weight: 600; }
.weight-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-top: 12rpx; width: 100%; box-sizing: border-box; }
.weight-left { flex: 1; min-width: 0; }
.weight-value { display: flex; align-items: baseline; gap: 2rpx; flex-wrap: wrap; }
.weight-value input { text-align: left; font-size: 84rpx; font-weight: 700; color: #5D4A49; width: 170rpx; height: 1em; line-height: 1; min-height: 0; background: transparent; padding: 0; margin: 0; }
.weight-unit { font-size: 32rpx; color: #7A5A58; }
.bmi-badge { align-self: flex-end; margin-left: 20rpx; margin-bottom: 6rpx; padding: 4rpx 10rpx; background: rgba(255,245,242,0.85); border: 1rpx solid rgba(255,230,225,0.6); border-radius: 12rpx; }
.bmi-text { font-size: 22rpx; color: #7A5A58; font-weight: 500; }
.day-badge { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; padding: 24rpx; min-width: 150rpx; max-width: 170rpx; box-sizing: border-box; background: #FDF8F0; border: 1rpx solid #F2EBD0; border-radius: 20rpx; flex: none; }
.day-text { font-size: 24rpx; color: #9A8A88; }
.day-count-row { display: flex; align-items: baseline; gap: 8rpx; }
.day-count { font-size: 36rpx; color: #6B4F4D; font-weight: 700; }
.day-unit { font-size: 24rpx; color: #9A8A88; }
.weight-loss { margin-top: 18rpx; font-size: 24rpx; color: #9A8A88; }
