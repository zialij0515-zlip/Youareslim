.type-row{display:flex;gap:12rpx;overflow-x:auto;margin:26rpx 0}.type,.chip{white-space:nowrap;padding:16rpx 22rpx;border-radius:32rpx;background:#EEF1EC;color:#6B786F;font-size:26rpx}.type.selected,.chip.selected{background:#D7E9D9;color:#3F7655;font-weight:600}.form{padding:30rpx}.field-title{font-size:29rpx;font-weight:600}.chips{display:flex;gap:14rpx;margin:20rpx 0 28rpx}.estimate{display:flex;align-items:center;background:#F2F7F1;border-radius:20rpx;padding:20rpx;margin-bottom:22rpx;color:#587761}.estimate input{flex:1;text-align:right;font-size:38rpx;font-weight:700;color:#3D604A}.form textarea{background:#F8F8F4;width:100%;min-height:180rpx;box-sizing:border-box;padding:20rpx;border-radius:20rpx;font-size:28rpx}.image-button{margin-top:18rpx;background:transparent;color:#54886A;font-size:27rpx}.image-count{text-align:center;color:#839087;font-size:24rpx}.weight{padding:25rpx;display:flex;align-items:center;gap:16rpx}.weight input{flex:1;text-align:right;font-size:36rpx;font-weight:700}.weight .ghost-button{width:130rpx;margin:0;font-size:25rpx;line-height:68rpx}
