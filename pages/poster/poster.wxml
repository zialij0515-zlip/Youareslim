<view class="page">
  <view class="poster-card">
    <text class="brand">轻减日记</text>
    <text class="flower">✦</text>
    <text class="headline">{{reached ? '我做到了！' : '我正在靠近目标'}}</text>
    <text class="name">{{profile.nickname}}</text>
    <view class="numbers">
      <view class="number-block">
        <text class="number-label">起始</text>
        <text class="number-value">{{profile.startWeight}}<text class="number-unit"> kg</text></text>
      </view>
      <view class="number-block">
        <text class="number-label">当前</text>
        <text class="number-value">{{current.weight || profile.startWeight}}<text class="number-unit"> kg</text></text>
      </view>
      <view class="number-block">
        <text class="number-label">目标</text>
        <text class="number-value">{{profile.targetWeight}}<text class="number-unit"> kg</text></text>
      </view>
    </view>
    <text class="caption">{{reached ? '每一份坚持，都值得被看见。' : '慢慢来，记录本身也是一种进步。'}}</text>
  </view>
  <text class="muted hint">海报采用动态数据生成；保存前会在真机中完成清晰度与安全区校验。</text>
  <button class="primary-button" bindtap="save">保存海报</button>
</view>
