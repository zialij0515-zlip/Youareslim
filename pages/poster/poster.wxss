.poster-card{margin:30rpx 0;background:linear-gradient(150deg,#D9EDDB,#FFF8E9);border-radius:42rpx;min-height:850rpx;padding:54rpx 45rpx;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;color:#376146}.brand{font-size:28rpx;letter-spacing:6rpx}.flower{font-size:76rpx;color:#E6A774;margin:72rpx 0 22rpx}.headline{font-size:51rpx;font-weight:700}.name{margin-top:22rpx;font-size:30rpx}.numbers{width:100%;margin-top:105rpx;display:flex;justify-content:space-between}.numbers view{display:flex;flex-direction:column;gap:15rpx;text-align:center;color:#6B806F;font-size:24rpx}.numbers b{font-size:40rpx;color:#365E45}.numbers small{font-size:20rpx}.caption{margin-top:auto;font-size:29rpx}.hint{display:block;text-align:center;line-height:1.6;margin:0 20rpx 25rpx}
