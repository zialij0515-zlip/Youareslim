.page { padding: 30rpx; display: flex; flex-direction: column; align-items: center; }
.poster-canvas {
  width: 600rpx;
  height: 840rpx;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(79, 133, 103, 0.18);
  background: linear-gradient(150deg, #D9EDDB, #FFF8E9);
  transform: translateZ(0);
}
.hint {
  display: block;
  text-align: center;
  line-height: 1.6;
  margin: 28rpx 20rpx 25rpx;
  color: #929B94;
  font-size: 24rpx;
}
.primary-button {
  background: #4F8567;
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  width: 100%;
}
